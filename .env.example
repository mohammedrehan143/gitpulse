# ==============================================================================
# GitPulse Platform Environment Configuration
# ==============================================================================

# Application Environment (development, staging, production)
GITPULSE_ENV=development
LOG_LEVEL=INFO

# ------------------------------------------------------------------------------
# GitHub Integration & Automatic Discovery
# ------------------------------------------------------------------------------
# Personal access token with repo, read:org, and read:user scopes
GITHUB_TOKEN=ghp_exampleTokenDoNotCommitSecrets
GITHUB_API_BASE_URL=https://api.github.com
GITHUB_RATE_LIMIT_BUFFER=100

# When true, automatically discovers and monitors all repositories owned by the authenticated account
AUTO_DISCOVER_REPOSITORIES=true
REPO_DISCOVERY_INTERVAL_MINUTES=60

# Manual fallback repository list when automatic discovery is disabled or unauthenticated
GITHUB_TARGET_REPOS=apache/spark,fastapi/fastapi,facebook/react

# ------------------------------------------------------------------------------
# Database Configurations (PostgreSQL & ClickHouse)
# ------------------------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=gitpulse
POSTGRES_USER=gitpulse_admin
POSTGRES_PASSWORD=gitpulse_secure_password
DATABASE_URL=postgresql+asyncpg://gitpulse_admin:gitpulse_secure_password@localhost:5432/gitpulse

CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=9000
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_DB=gitpulse_analytics
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=

# ------------------------------------------------------------------------------
# Message Streaming (Apache Kafka / Redpanda)
# ------------------------------------------------------------------------------
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_RAW_EVENTS=gitpulse.github.raw_events
KAFKA_TOPIC_COMMITS=gitpulse.github.commits
KAFKA_TOPIC_PULL_REQUESTS=gitpulse.github.pull_requests
KAFKA_TOPIC_METRICS=gitpulse.analytics.metrics
KAFKA_CONSUMER_GROUP=gitpulse-stream-processors
KAFKA_SECURITY_PROTOCOL=PLAINTEXT

# ------------------------------------------------------------------------------
# Object Storage & Lakehouse (MinIO / S3 / Apache Iceberg)
# ------------------------------------------------------------------------------
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_LAKEHOUSE=gitpulse-lakehouse
MINIO_SECURE=false

# ------------------------------------------------------------------------------
# Apache Airflow
# ------------------------------------------------------------------------------
AIRFLOW__CORE__LOAD_EXAMPLES=False
AIRFLOW__CORE__SQL_ALCHEMY_CONN=postgresql+psycopg2://gitpulse_admin:gitpulse_secure_password@localhost:5432/gitpulse
AIRFLOW_WWW_USER_USERNAME=admin
AIRFLOW_WWW_USER_PASSWORD=admin

# ------------------------------------------------------------------------------
# FastAPI Backend
# ------------------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ------------------------------------------------------------------------------
# Frontend Dashboard (Vite / React)
# ------------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_WS_BASE_URL=ws://localhost:8000/api/v1/ws

# ------------------------------------------------------------------------------
# Multi-Agent Runtime Orchestration
# ------------------------------------------------------------------------------
AGENT_RUNTIME_DIR=agent_runtime
AGENT_CHECKPOINT_DIR=agent_runtime/.state_checkpoints
AGENT_LOG_DIR=agent_runtime/.telemetry_logs
AGENT_MAX_RETRIES=3
AGENT_TIMEOUT_SECONDS=300
AGENT_EXECUTION_MODE=hierarchical
LLM_PROVIDER=groq
GROQ_MODEL=openai/gpt-oss-120b
GROQ_API_KEY=your_groq_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
