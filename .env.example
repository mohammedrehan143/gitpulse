# ==============================================================================
# GitPulse Platform Environment Configuration
# ==============================================================================

# Application Environment (development, staging, production)
GITPULSE_ENV=development
LOG_LEVEL=INFO

# ------------------------------------------------------------------------------
# GitHub Integration & Automatic Discovery
# ------------------------------------------------------------------------------
# Personal access token with repo, read:org, and read:user scopes
GITHUB_TOKEN=ghp_exampleTokenDoNotCommitSecrets
GITHUB_API_BASE_URL=https://api.github.com
GITHUB_RATE_LIMIT_BUFFER=100

# When true, automatically discovers and monitors all repositories owned by the authenticated account
AUTO_DISCOVER_REPOSITORIES=true
REPO_DISCOVERY_INTERVAL_MINUTES=60

# Manual fallback repository list when automatic discovery is disabled or unauthenticated
GITHUB_TARGET_REPOS=apache/spark,fastapi/fastapi,facebook/react

# ------------------------------------------------------------------------------
# Supabase Relational Database & Cloud Storage
# ------------------------------------------------------------------------------
# Supabase connection URI (Session Pooler: 5432 or Transaction Pooler: 6543)
# Example: postgresql+asyncpg://postgres.[your-project-ref]:[your-password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql+asyncpg://postgres.[your-project-ref]:[your-password]@aws-0-[region].pooler.supabase.com:6543/postgres

# Supabase Project API Credentials
SUPABASE_URL=https://[your-project-ref].supabase.co
SUPABASE_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ------------------------------------------------------------------------------
# Caching & Background Broker (Redis)
# ------------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# GitHub webhook security
GITHUB_WEBHOOK_SECRET=your_github_webhook_secret_here

# ------------------------------------------------------------------------------
# Lightweight Ingestion Scheduler (Replaces Apache Airflow)
# ------------------------------------------------------------------------------
INGESTION_SCHEDULE_INTERVAL_MINUTES=60

# ------------------------------------------------------------------------------
# FastAPI Backend
# ------------------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ------------------------------------------------------------------------------
# Frontend Dashboard (Vite / React)
# ------------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_WS_BASE_URL=ws://localhost:8000/api/v1/ws

# ------------------------------------------------------------------------------
# Notifications & Webhooks (Discord, Alerts)
# ------------------------------------------------------------------------------
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your_webhook_id/your_webhook_token

# ------------------------------------------------------------------------------
# Multi-Agent Runtime Orchestration
# ------------------------------------------------------------------------------
AGENT_RUNTIME_DIR=agent_runtime
AGENT_CHECKPOINT_DIR=agent_runtime/.state_checkpoints
AGENT_LOG_DIR=agent_runtime/.telemetry_logs
AGENT_MAX_RETRIES=3
AGENT_TIMEOUT_SECONDS=300
AGENT_EXECUTION_MODE=hierarchical
LLM_PROVIDER=groq
GROQ_MODEL=openai/gpt-oss-120b
GROQ_API_KEY=your_groq_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
