{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "GitHubEventSchema",
  "type": "object",
  "required": ["event_id", "event_type", "repo_id", "actor_login", "created_at"],
  "properties": {
    "event_id": { "type": "string" },
    "event_type": { "type": "string", "enum": ["PushEvent", "PullRequestEvent", "IssuesEvent", "PullRequestReviewEvent"] },
    "repo_id": { "type": "integer" },
    "actor_login": { "type": "string" },
    "action": { "type": ["string", "null"] },
    "payload_summary": { "type": ["string", "null"] },
    "created_at": { "type": "string", "format": "date-time" }
  }
}
