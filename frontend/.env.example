# GitPulse Backend API URL
# Provide the Render URL where your backend is deployed
# Example: https://gitpulse-api.onrender.com or https://gitpulse-api.onrender.com/api/v1
VITE_API_BASE_URL=https://gitpulse-api.onrender.com

# GitPulse WebSocket URL (Optional - automatically derived from VITE_API_BASE_URL if omitted)
# Example: wss://gitpulse-api.onrender.com/api/v1/ws
VITE_WS_BASE_URL=wss://gitpulse-api.onrender.com/api/v1/ws
